{
  "name": "agent-fishtank",
  "productName": "Agent Fishtank",
  "version": "1.7.0",
  "type": "module",
  "description": "A desktop aquarium that visualizes GitHub Copilot CLI and Claude Code agent activity",
  "main": "dist-electron/main.js",
  "scripts": {
    "app": "npm run build && electron .",
    "start": "node server/index.ts",
    "dev": "vite",
    "build": "vite build && vite build -c vite.electron.config.mts --mode main && vite build -c vite.electron.config.mts --mode preload && vite build -c vite.electron.config.mts --mode cli",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "demo:record": "npm run build && node scripts/demo/record.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "lint": "oxlint --max-warnings=0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "oxlint": "^1.90.0",
    "pixi.js": "^8.22.0",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "Vincent Van Herreweghe",
  "repository": {
    "type": "git",
    "url": "https://github.com/VinnieVH/agents-fishtank.git"
  },
  "homepage": "https://github.com/VinnieVH/agents-fishtank",
  "build": {
    "appId": "com.vinnievh.agent-fishtank",
    "productName": "Agent Fishtank",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      "package.json",
      "!node_modules/node-pty/{build,deps,scripts,src,third_party,typings,binding.gyp}",
      "!node_modules/node-pty/lib/**/*.{map,test.js}",
      "!node_modules/node-pty/prebuilds/**/*.pdb"
    ],
    "extraResources": [
      {
        "from": "dist-electron/cli.mjs",
        "to": "cli/cli.mjs"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Clicking a fish brings the terminal tab its session runs in to the front."
      },
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "electron/bin/fishtank.sh",
          "to": "bin/fishtank.sh"
        }
      ],
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "electron/bin/fishtank.cmd",
          "to": "bin/fishtank.cmd"
        }
      ],
      "files": [
        "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "artifactName": "Agent-Fishtank-Setup.exe"
    },
    "dmg": {
      "artifactName": "Agent-Fishtank-${arch}.dmg"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false
  }
}
