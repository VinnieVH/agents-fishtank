{
  // The server runs straight from source with Node's type stripping during development (node server/index.ts),
  // so it may only use TypeScript syntax that can be erased: no enums, namespaces or parameter properties.
  // The desktop app's Node side (electron/) is bundled by Vite, but follows the same rules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["server", "shared", "electron"]
}
